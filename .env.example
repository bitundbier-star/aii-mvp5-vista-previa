# Copia este archivo como ".env" y llena los valores reales antes de
# desplegar a producción. En modo de prueba (sin llenar SMTP_*), los
# correos no se envían de verdad: se guardan como vista previa en
# data/correos_enviados/.

# Clave para firmar las sesiones (cámbiala por algo único y secreto)
SECRET_KEY=cambia-esta-clave-en-produccion

# Base de datos. Por defecto usa SQLite (archivo local, sin costo).
# Para producción con más de un conjunto o más volumen, considera
# Postgres, por ejemplo: postgresql://usuario:password@host:5432/aii
# DATABASE_URL=sqlite:///data/aii.db

# Correo saliente (SMTP). Ejemplo con Gmail (requiere "contraseña de
# aplicación", no tu contraseña normal): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com

# Suscripción de la cuenta a AII, cobrada vía Stripe. Mientras no llenes
# STRIPE_SECRET_KEY, la sección "Método de pago" en Configuración se queda
# en modo de prueba (no falla, solo avisa que falta configurarlo).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
